# Copy to .env and fill in. Never commit .env.

# --- Infrastructure (defaults match docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://insightforge:insightforge@localhost:5432/insightforge
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- LLMs via OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
MODEL_PRIMARY=anthropic/claude-sonnet-5.5
MODEL_SECONDARY=anthropic/claude-haiku-5.5
# Cheap open-weight alternative (verified 2026-10-20, ~1/50 the cost):
# MODEL_PRIMARY=deepseek/deepseek-v4.1-flash
# MODEL_SECONDARY=z-ai/glm-5.3-flash

# --- Web search: tavily | brave | serpapi (only the chosen one needs a key) ---
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPAPI_API_KEY=

# --- Security (generate with: openssl rand -hex 32) ---
JWT_SECRET=
WEBHOOK_SIGNING_SECRET=

# --- Optional overrides (defaults in backend/src/insightforge/config.py) ---
# EVIDENCE_BUNDLE_TOKEN_BUDGET=6000
# RUN_TOKEN_BUDGET=250000
# MAX_CONCURRENT_RUNS=4

# --- LangSmith tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=insightforge
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
